          <mxGeometry x="940" y="210" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="P" value="&lt;b&gt;Prepare&lt;/b&gt;&lt;br&gt;&lt;br&gt;Normalise newlines only&lt;br&gt;Paragraph-aware; target 500&lt;br&gt;Keep blocks; no execution" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontSize=21;fillColor=#EDF4FC;strokeColor=#668CB7;" vertex="1" parent="1">
          <mxGeometry x="1380" y="210" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="C" value="&lt;b&gt;Part B comparison selects configuration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fixed: 320 chunks; 17 boundaries inside fenced blocks&lt;br&gt;Paragraph-aware: 350 chunks; 0 fence cuts; 0 mid-line cuts&lt;br&gt;Accepted: 49 chunks above target; maximum 2,749 characters&lt;br&gt;Use the same chosen configuration in Part C" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontSize=21;fillColor=#EAF5EF;strokeColor=#5C9974;" vertex="1" parent="1">
          <mxGeometry x="940" y="520" width="790" height="200" as="geometry" />
        </mxCell>
        <mxCell id="F" value="&lt;b&gt;Failure points and responses&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Missing source / wrong SHA-256 -&amp;gt; stop; do not refresh silently&lt;br&gt;2. Bad UTF-8 / unclosed Markdown fence -&amp;gt; stop and inspect&lt;br&gt;Output or lineage validation failure also stops the run&lt;br&gt;Do not mistake RST underline headings for Markdown fences" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontSize=21;fillColor=#FFF0F0;strokeColor=#BD7272;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="790" height="200" as="geometry" />
        </mxCell>
        <mxCell id="O" value="&lt;b&gt;Store prepared data&lt;/b&gt;&lt;br&gt;&lt;br&gt;JSONL with stable record IDs&lt;br&gt;Repository, commit, URL, hash&lt;br&gt;Section + exact line/span" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontSize=21;fillColor=#EDF4FC;strokeColor=#668CB7;" vertex="1" parent="1">
          <mxGeometry x="1380" y="900" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="V" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Non-empty; unique IDs&lt;br&gt;Read-back equals export&lt;br&gt;Exact spans; no content loss" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=18;fontSize=21;fillColor=#FFF3DD;strokeColor=#BB8B3A;" vertex="1" parent="1">
