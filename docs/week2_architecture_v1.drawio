        </mxCell>
        <mxCell id="A1" value="&lt;b&gt;A1 Student or beginner&lt;/b&gt;&lt;br&gt;&lt;br&gt;Question + selected&lt;br&gt;repository or pair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#5A88C1;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
