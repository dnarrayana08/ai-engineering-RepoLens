        </mxCell>
        <mxCell id="A6" value="&lt;b&gt;A6 Output and evidence checks&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check source identity and structure&lt;br&gt;Do not claim automatic truth verification&lt;br&gt;FR3 / RAI1 / RAI3 / RAI5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DE;strokeColor=#C18A32;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
