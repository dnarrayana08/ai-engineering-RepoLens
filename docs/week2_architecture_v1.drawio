          <mxGeometry x="60" y="145" width="1650" height="35" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="&lt;b&gt;QUESTION ANSWERING / one repository or a supported pair&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=23;fontColor=#122034;" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="1650" height="35" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="&lt;b&gt;S1 Selected public documents&lt;/b&gt;&lt;br&gt;&lt;br&gt;8 pinned Markdown / RST files&lt;br&gt;FastAPI, Streamlit, scikit-learn&lt;br&gt;No linked pages or code execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#57956A;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
