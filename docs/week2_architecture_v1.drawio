        </mxCell>
        <mxCell id="S2" value="&lt;b&gt;S2 Source review and preparation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allowlist and source-rights checks&lt;br&gt;Preserve sections and provenance&lt;br&gt;FR2 / FR3 / FR7 / RAI5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#57956A;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="200" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="&lt;b&gt;S3 Approved knowledge collection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Content + repository / file / section&lt;br&gt;Fixed commit identity and URLs&lt;br&gt;FR2 / FR3 / FR7 / RAI5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#57956A;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
