        </mxCell>
        <mxCell id="A2" value="&lt;b&gt;A2 Application interface&lt;/b&gt;&lt;br&gt;&lt;br&gt;Selection, query and display&lt;br&gt;Shared 30 s request deadline&lt;br&gt;FR1 / FR6 / FR7 / NFR5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEEF0;strokeColor=#C77985;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="610" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="&lt;b&gt;A3 Input scope and privacy control&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check repository and task boundary&lt;br&gt;Block detected secrets before model call&lt;br&gt;FR5 / RAI2 / RAI4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DE;strokeColor=#C18A32;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="610" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="&lt;b&gt;A4 Knowledge access&lt;/b&gt;&lt;br&gt;&lt;br&gt;Relevant evidence per repository&lt;br&gt;Check sufficiency; cover both sides&lt;br&gt;FR2 / FR4 / NFR3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#57956A;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="610" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="A5" value="&lt;b&gt;A5 Language model service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Permitted question + bounded evidence&lt;br&gt;Evidence is not system instructions&lt;br&gt;Draft explanation; no execution tools&lt;br&gt;FR2 / FR4 / FR6 / RAI3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5EE;strokeColor=#57956A;fontColor=#182A38;fontSize=20;align=left;verticalAlign=middle;spacing=18;arcSize=10;" vertex="1" parent="1">
